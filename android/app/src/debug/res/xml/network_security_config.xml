<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. This file lives in src/debug and replaces the release
  config of the same name, so it cannot ship in a store or sideloaded build.

  It permits cleartext to the loopback addresses a local backend listens on
  (10.0.2.2 is the host machine as seen from the Android emulator) so a
  developer can run uvicorn on http without a certificate. Everything else
  still refuses cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
