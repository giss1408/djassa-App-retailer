<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen (Android < 12): the Djassa mark on paper, shown until
     Flutter draws its first frame. Android 12+ uses values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/djassa_paper" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
