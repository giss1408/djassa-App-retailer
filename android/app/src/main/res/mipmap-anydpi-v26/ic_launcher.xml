<?xml version="1.0" encoding="utf-8"?>
<!-- Hossouko Pro: the Hossouko mark with "pro" under it, with no tile behind it:
     the background layer is transparent, so the launcher shows the mark on the
     wallpaper. Everything sits inside the launcher's safe circle, so its crop
     (circle, squircle...) cuts nothing. Drawn by scripts/make-icons.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
